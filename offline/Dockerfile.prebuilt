# 使用预编译二进制构建镜像（无需 Go 工具链）
# 构建前将对应架构二进制放到构建上下文并命名为 zcode-cdn-mock：
#   cp zcode-cdn-mock_linux_amd64 zcode-cdn-mock
#   docker build -f Dockerfile.prebuilt -t zcode-cdn-mock:local .
FROM scratch
COPY zcode-cdn-mock /cdn

ENV CDN_ROOT=/data
ENV PORT=80
ENV BIND=0.0.0.0

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/cdn", "-healthcheck"]

ENTRYPOINT ["/cdn"]
