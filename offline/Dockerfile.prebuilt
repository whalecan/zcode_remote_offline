# 使用预编译二进制构建镜像（无需 Go 工具链）
# 构建前将对应架构二进制放到构建上下文并命名为 zcode-remote-server-downloader：
#   cp zcode-remote-server-downloader_linux_amd64 zcode-remote-server-downloader
#   docker build -f Dockerfile.prebuilt -t zcode-remote-server-downloader:local .
FROM scratch
COPY zcode-remote-server-downloader /cdn

ENV CDN_ROOT=/data
ENV PORT=80
ENV BIND=0.0.0.0

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/cdn", "-healthcheck"]

ENTRYPOINT ["/cdn"]
